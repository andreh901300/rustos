#!/usr/bin/env bash
# RustOS debug and mod tool. Type  .debug help  in a terminal.
#   .debug              short overview
#   .debug help         every command
#   .debug mainmod      the main mod menu: turn RustOS tweaks on and off, make your own mods
# Also works as  rustos-debug ...  (".debug" is a link to this file).

VERSION_FILE=/usr/share/rustos/os-release
MODDIR="$HOME/.config/rustos/mods"
STATE="$HOME/.config/rustos/mods.state"
BASHRC="$HOME/.bashrc"
ME=".debug"

# ------------------------------------------------------------------ looks
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\e[1m'; D=$'\e[2m'; R=$'\e[0m'; OR=$'\e[38;5;208m'; GR=$'\e[38;5;42m'; RD=$'\e[38;5;203m'; CY=$'\e[38;5;37m'; YL=$'\e[38;5;221m'
else
  B=""; D=""; R=""; OR=""; GR=""; RD=""; CY=""; YL=""
fi
title() { printf '\n%s%s== %s ==%s\n' "$B" "$OR" "$*" "$R"; }
ok()    { printf '  %s✓%s %s\n' "$GR" "$R" "$*"; }
bad()   { printf '  %s✗%s %s\n' "$RD" "$R" "$*"; }
info()  { printf '  %s•%s %s\n' "$CY" "$R" "$*"; }
kv()    { printf '  %s%-16s%s %s\n' "$OR" "$1" "$R" "$2"; }
have()  { command -v "$1" >/dev/null 2>&1; }
need_root() { if [ "$(id -u)" != 0 ]; then sudo "$@"; else "$@"; fi; }
kw() { if have kwriteconfig6; then kwriteconfig6 "$@"; elif have kwriteconfig5; then kwriteconfig5 "$@"; else return 127; fi; }
kr() { if have kreadconfig6; then kreadconfig6 "$@"; elif have kreadconfig5; then kreadconfig5 "$@"; fi; }
kde_notify() { dbus-send --session --type=signal /KGlobalSettings org.kde.KGlobalSettings.notifyChange "int32:$1" int32:0 >/dev/null 2>&1; return 0; }

rustos_version() {
  local v
  v=$(pacman -Q rustos-base 2>/dev/null | awk '{print $2}')
  [ -n "$v" ] && { echo "$v"; return; }
  # shellcheck disable=SC1090
  [ -r "$VERSION_FILE" ] && . "$VERSION_FILE" 2>/dev/null && echo "${VERSION_ID:-${VERSION:-unknown}}" && return
  echo unknown
}
repo_base() {   # update channel address, from pacman.conf
  awk '/^\[rustos\]/{f=1;next} /^\[/{f=0} f && /^Server/{sub(/^Server *= */,""); sub(/\/\$arch.*$/,""); print; exit}' /etc/pacman.conf 2>/dev/null
}

# ------------------------------------------------------------------ help
usage() {
  cat <<EOF
${B}${OR}RustOS debug${R}  ${D}(.debug or rustos-debug)${R}

${B}Look around${R}
  $ME info              what this PC is running (version, kernel, desktop, graphics, disk)
  $ME update            is the update channel online? is an update waiting?
  $ME logs [what]       errors from this boot. what = boot | last | update | kernel
  $ME services          services that failed, and the RustOS ones
  $ME net               network, DNS and internet test
  $ME gpu               graphics card and driver
  $ME disk              disk space and the biggest folders in your home
  $ME report            save everything above into one text file to share (no passwords in it)
  $ME boot              how long the start takes, and what is slow
  $ME temp              temperatures         $ME battery    battery level and health
  $ME top               what uses the CPU and memory      $ME watch   live view (q stops)
  $ME wine              Windows programs: Wine, the EXE Center, what is running
  $ME packages          how many packages, which are not needed     $ME history   last installs and updates
  $ME restore           restore points (undo an update)
  $ME usb | display | sound | bluetooth | ports | env | crash   details for each
  $ME speed             internet speed test   $ME bench   quick CPU and disk test
  $ME clean             free up disk space (old packages, unused parts, caches)

${B}Fix things${R}
  $ME fix               list the quick fixes
  $ME fix <name>        run one: plasma | audio | network | dns | time | pacman-lock | keyring | ipad |
                        flatpak | fonts | icons | initramfs | grub | bootsplash | mirrors | exe

${B}Mods (custom tweaks you can turn on and off)${R}
  $ME mainmod           the main mod menu: pick a number to turn a mod on or off
  $ME mods              list every mod and if it is on
  $ME mod <name> on     turn a mod on      ($ME mod <name> off  turns it off)
  $ME mod new <name>    make your own mod (a small script you fill in)
  $ME mod edit <name>   open your mod in a text editor
  $ME mod delete <name> remove your own mod

${B}Other${R}
  $ME version           RustOS version
  $ME help              this list
EOF
}

overview() {
  printf '%s%sRustOS debug%s  %sversion %s%s\n' "$B" "$OR" "$R" "$D" "$(rustos_version)" "$R"
  printf 'Try:  %s.debug info%s   %s.debug mainmod%s   %s.debug fix%s   %s.debug help%s\n' "$CY" "$R" "$CY" "$R" "$CY" "$R" "$CY" "$R"
}

# ------------------------------------------------------------------ look around
cmd_info() {
  title "This PC"
  kv "RustOS" "$(rustos_version)"
  kv "Kernel" "$(uname -r) ($(uname -m))"
  kv "Desktop" "${XDG_CURRENT_DESKTOP:-none} ${XDG_SESSION_TYPE:+(${XDG_SESSION_TYPE})}"
  have plasmashell && kv "Plasma" "$(plasmashell --version 2>/dev/null | awk '{print $2}')"
  kv "Uptime" "$(uptime -p 2>/dev/null | sed 's/^up //')"
  kv "Memory" "$(free -h 2>/dev/null | awk '/^Mem:/{print $3 " used of " $2}')"
  kv "Swap (zram)" "$(swapon --show=NAME,SIZE --noheadings 2>/dev/null | tr '\n' ' ' | sed 's/ *$//')"
  kv "Disk /" "$(df -h / 2>/dev/null | awk 'NR==2{print $3 " used of " $2 " (" $5 ")"}')"
  have lspci && kv "Graphics" "$(lspci 2>/dev/null | grep -Ei 'vga|3d|display' | head -n1 | sed 's/^[^:]*: //' | cut -c1-70)"
  kv "Virtual machine" "$(systemd-detect-virt 2>/dev/null || echo none)"
  kv "Boot loader" "$(boot_loader)"
  local au; au=$(systemctl is-enabled rustos-update.timer 2>/dev/null); kv "Auto updates" "${au:-unknown}"
  have rustos-ipad-mode && kv "iPad mode" "$(rustos-ipad-mode status 2>/dev/null)"
  kv "Update channel" "$(repo_base || true)"
}
boot_loader() {
  if [ -d /boot/grub ] || [ -d /efi/grub ]; then echo GRUB; return; fi
  if [ -d /boot/loader/entries ] || [ -d /efi/loader/entries ]; then echo systemd-boot; return; fi
  if ls /boot/limine* /boot/EFI/limine >/dev/null 2>&1; then echo Limine; return; fi
  if [ -d /boot/EFI/refind ]; then echo rEFInd; return; fi
  echo unknown
}

cmd_update() {
  title "Update channel"
  local base local_v j remote
  base=$(repo_base)
  [ -n "$base" ] || { bad "No [rustos] repository in /etc/pacman.conf. Updates will not come in."; return 1; }
  kv "Address" "$base"
  local_v=$(pacman -Q rustos-base 2>/dev/null | awk '{print $2}')
  kv "Installed" "${local_v:-rustos-base is not installed}"
  if ! have curl; then bad "curl is missing"; return 1; fi
  j=$(curl -fsS --max-time 8 "$base/latest.json?t=$(date +%s)" 2>/dev/null)
  if [ -n "$j" ]; then
    remote=$(printf '%s' "$j" | sed -n 's/.*"pkgver":"\([^"]*\)".*/\1/p')
    ok "Channel is online. Newest: rustos-base ${remote:-?}"
  else
    info "No status file on the channel (older publish) - checking the package list instead"
  fi
  local arch; arch=$(uname -m)
  if curl -fsSI --max-time 8 "$base/$arch/rustos.db" >/dev/null 2>&1; then ok "Package list for $arch is there"; else bad "Package list for $arch not found (is GitHub Pages on? was the last publish green?)"; fi
  if [ -n "$remote" ] && [ -n "$local_v" ]; then
    if [ "${local_v%-*}" = "$remote" ]; then ok "You are up to date"
    elif [ "$(vercmp "${local_v%-*}" "$remote" 2>/dev/null)" = -1 ]; then info "${YL}Update waiting.${R} Get it now with:  sudo rustos-autoupdate now"
    else info "Yours is newer than the channel (fine while you are building RustOS)"; fi
  fi
  have rustos-autoupdate && { echo; rustos-autoupdate status 2>/dev/null | sed 's/^/  /'; }
}

cmd_logs() {
  case "${1:-boot}" in
    boot)   title "Errors since this start";  journalctl -b -p err --no-pager -n 60 2>/dev/null || bad "journalctl is not available" ;;
    last)   title "Errors from the start before"; journalctl -b -1 -p err --no-pager -n 60 2>/dev/null || bad "No earlier start saved" ;;
    kernel) title "Kernel warnings"; journalctl -k -b -p warning --no-pager -n 60 2>/dev/null ;;
    update) title "Update history"; tail -n 60 /var/log/rustos-update.log 2>/dev/null || bad "No update log yet" ;;
    *) echo "Use: $ME logs boot | last | kernel | update"; return 1 ;;
  esac
}

cmd_services() {
  title "Failed services"
  local f; f=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}')
  if [ -n "$f" ]; then while read -r u; do bad "$u   (see: systemctl status $u)"; done <<<"$f"; else ok "Nothing failed"; fi
  if [ -n "$(systemctl --user --failed --no-legend 2>/dev/null)" ]; then bad "Some of your own (user) services failed: systemctl --user --failed"; fi
  title "RustOS services"
  local u s
  for u in rustos-update.timer NetworkManager.service sddm.service bluetooth.service power-profiles-daemon.service systemd-timesyncd.service; do
    s=$(systemctl is-active "$u" 2>/dev/null); [ -n "$s" ] || s=unknown
    if [ "$s" = active ]; then ok "$u"; else info "$u: $s"; fi
  done
}

cmd_net() {
  title "Network"
  have nmcli && nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device 2>/dev/null | grep -v ':unmanaged' | while IFS=: read -r d t s c; do kv "$d ($t)" "$s ${c:+- $c}"; done
  local gw; gw=$(ip route 2>/dev/null | awk '/^default/{print $3; exit}')
  kv "Router" "${gw:-none}"
  if getent hosts archlinux.org >/dev/null 2>&1; then ok "DNS works"; else bad "DNS does not answer (names do not turn into addresses)"; fi
  if have curl && curl -fsS --max-time 6 -o /dev/null https://archlinux.org 2>/dev/null; then ok "Internet works"; else bad "Cannot reach the internet"; fi
}

cmd_gpu() {
  title "Graphics"
  have lspci && lspci -k 2>/dev/null | grep -EiA3 'vga|3d controller|display' | sed 's/^/  /'
  have glxinfo && kv "OpenGL" "$(glxinfo -B 2>/dev/null | awk -F': ' '/OpenGL renderer/{print $2}')"
  if have vulkaninfo; then kv "Vulkan" "$(vulkaninfo --summary 2>/dev/null | awk -F'= ' '/deviceName/{print $2; exit}')"; else info "vulkaninfo not installed (it comes with the Gaming Setup)"; fi
  [ -e /proc/driver/nvidia/version ] && kv "NVIDIA driver" "$(head -n1 /proc/driver/nvidia/version | awk '{print $8}')"
}

cmd_disk() {
  title "Disk space"
  df -h -x tmpfs -x devtmpfs -x squashfs -x overlay 2>/dev/null | sed 's/^/  /'
  title "Biggest folders in your home"
  du -xh --max-depth=1 "$HOME" 2>/dev/null | sort -rh | head -n 8 | sed 's/^/  /'
  local c; c=$(du -sh /var/cache/pacman/pkg 2>/dev/null | awk '{print $1}')
  [ -n "$c" ] && info "Package cache: $c  (clean it with: sudo paccache -rk1)"
}

cmd_report() {
  local f; f="$HOME/rustos-debug-$(date +%Y%m%d-%H%M).txt"
  {
    echo "RustOS debug report, $(date)"
    NO_COLOR=1 "$0" info; NO_COLOR=1 "$0" update; NO_COLOR=1 "$0" services; NO_COLOR=1 "$0" net; NO_COLOR=1 "$0" gpu; NO_COLOR=1 "$0" disk
    NO_COLOR=1 "$0" mods; NO_COLOR=1 "$0" boot; NO_COLOR=1 "$0" wine; NO_COLOR=1 "$0" packages; NO_COLOR=1 "$0" history 40
    echo; echo "== Errors since this start =="; journalctl -b -p err --no-pager -n 150 2>/dev/null
    echo; echo "== Update log =="; tail -n 80 /var/log/rustos-update.log 2>/dev/null
  } > "$f" 2>&1
  ok "Saved: $f"
  info "Send that file when you ask for help (Discord). It has no passwords in it."
}

# ------------------------------------------------------------------ more (RustOS 2.9)
cmd_boot() {
  title "Start-up"
  have systemd-analyze && kv "Start time" "$(systemd-analyze 2>/dev/null | head -n1 | sed 's/^Startup finished in //')"
  kv "Boot loader" "$(boot_loader)"
  have rustos-bootsplash && kv "Boot screen" "$(rustos-bootsplash status 2>/dev/null | head -n1 | sed 's/^Boot screen: //')"
  kv "Kernel options" "$(cut -c1-90 /proc/cmdline 2>/dev/null)"
  title "Slowest parts of the start"
  have systemd-analyze && systemd-analyze blame --no-pager 2>/dev/null | head -n 10 | sed 's/^/  /'
}

cmd_temp() {
  title "Temperatures"
  if have sensors; then sensors 2>/dev/null | grep -E '°C' | sed 's/^/  /' | head -n 20
  else
    local z t n
    for z in /sys/class/thermal/thermal_zone*; do
      [ -r "$z/temp" ] || continue
      t=$(cat "$z/temp"); n=$(cat "$z/type" 2>/dev/null)
      kv "${n:-zone}" "$((t / 1000)) °C"
    done
    info "More detail: install lm_sensors (RustOS Apps, Tools) and run: sudo sensors-detect"
  fi
}

cmd_battery() {
  title "Battery"
  local b found=0
  for b in /sys/class/power_supply/BAT*; do
    [ -d "$b" ] || continue; found=1
    kv "${b##*/}" "$(cat "$b/capacity" 2>/dev/null)%  ($(cat "$b/status" 2>/dev/null))"
    if [ -r "$b/energy_full" ] && [ -r "$b/energy_full_design" ]; then
      kv "Health" "$(( $(cat "$b/energy_full") * 100 / $(cat "$b/energy_full_design") ))% of new"
    elif [ -r "$b/charge_full" ] && [ -r "$b/charge_full_design" ]; then
      kv "Health" "$(( $(cat "$b/charge_full") * 100 / $(cat "$b/charge_full_design") ))% of new"
    fi
    [ -r "$b/cycle_count" ] && kv "Charge cycles" "$(cat "$b/cycle_count")"
  done
  [ "$found" = 1 ] || info "No battery (a desktop PC or a virtual machine)"
  have powerprofilesctl && kv "Power mode" "$(powerprofilesctl get 2>/dev/null)"
}

cmd_top() {
  title "Using the most CPU"
  ps -eo pcpu,pmem,comm --sort=-pcpu 2>/dev/null | head -n 8 | sed 's/^/  /'
  title "Using the most memory"
  ps -eo pmem,rss,comm --sort=-rss 2>/dev/null | head -n 8 | awk 'NR==1{print "  " $0; next} {printf "  %5s %7.0f MB %s\n", $1, $2/1024, $3}'
  kv "Load" "$(cut -d' ' -f1-3 /proc/loadavg)  (on $(nproc) cores)"
}

cmd_usb() {
  title "USB devices"
  if have lsusb; then lsusb 2>/dev/null | sed 's/^Bus [0-9]* Device [0-9]*: ID /  /'; else bad "lsusb is missing (package usbutils)"; fi
}

cmd_ports() {
  title "Programs listening on the network"
  ss -tulpn 2>/dev/null | awk 'NR==1 || /LISTEN|UNCONN/' | head -n 25 | sed 's/^/  /'
  info "Nothing here should surprise you. Ask in the Discord if something looks odd."
}

cmd_wine() {
  title "Windows programs (Wine)"
  local pfx="${WINEPREFIX:-$HOME/.wine}"
  if have wine; then kv "Wine" "$(wine --version 2>/dev/null)"; else bad "Wine is not installed (double-click an .exe and RustOS offers it)"; fi
  if [ -d "$pfx/drive_c" ]; then
    kv "Environment" "$pfx ($(du -sh "$pfx" 2>/dev/null | cut -f1))"
    [ -f "$pfx/drive_c/windows/system32/dxgi.dll" ] && grep -qa dxvk "$pfx/drive_c/windows/system32/dxgi.dll" 2>/dev/null && ok "DXVK is installed"
  else info "No Windows environment yet (it is made the first time you run a program)"; fi
  kv "EXE Center folder" "$HOME/EXE-Center"
  have winetricks && kv "Added with winetricks" "$(winetricks list-installed 2>/dev/null | tr '\n' ' ' | cut -c1-80)"
  local running
  # shellcheck disable=SC2009
  running=$(ps -u "$(id -u)" -o args= 2>/dev/null | grep -oiE '^([A-Za-z]:\\.*|/[^ ]*)\.exe' | sed 's/.*[\\/]//' | grep -viE '^(wineserver|services|winedevice|explorer|plugplay|svchost|rpcss|conhost|start)\.exe$' | sort -u | tr '\n' ' ')
  kv "Running now" "${running:-nothing}"
  if python3 -c 'import PyQt6.QtWidgets' 2>/dev/null; then ok "EXE Center window can start"; else bad "PyQt6 is missing: the EXE Center uses the classic menu (.debug fix exe)"; fi
  [ -s "$HOME/.cache/rustos-exe-center/window.log" ] && info "EXE Center window errors: $HOME/.cache/rustos-exe-center/window.log"
}

cmd_packages() {
  title "Packages"
  kv "Installed" "$(pacman -Qq 2>/dev/null | wc -l)"
  kv "You installed" "$(pacman -Qqe 2>/dev/null | wc -l) (the rest came along as needed)"
  local orph; orph=$(pacman -Qtdq 2>/dev/null | wc -l)
  kv "Not needed any more" "$orph  ${orph:+(remove with: .debug clean)}"
  have flatpak && kv "Flatpak apps" "$(flatpak list --app 2>/dev/null | wc -l)"
  kv "Cache" "$(du -sh /var/cache/pacman/pkg 2>/dev/null | cut -f1)"
}

cmd_history() {
  title "Last package changes"
  grep -E '\[ALPM\] (installed|upgraded|removed)' /var/log/pacman.log 2>/dev/null | tail -n "${1:-20}" | sed -E 's/^\[([0-9T:-]+)[^]]*\] \[ALPM\] /  \1  /'
}

cmd_restore() {
  title "Restore points (undo an update)"
  local f n=0
  for f in $(ls -1t /var/lib/rustos/restorepoints/*.list 2>/dev/null | head -n 8); do
    n=$((n + 1)); kv "$(date -r "$f" '+%a %d %b %H:%M')" "$(wc -l < "$f") packages saved"
  done
  [ "$n" -gt 0 ] || info "No restore points yet (one is saved before every update)"
  info "Go back with: sudo rustos-rollback   (or Update Center, Undo the last update)"
}

cmd_clean() {
  title "Clean up"
  local before; before=$(df --output=avail -B1M / | tail -n1)
  if have paccache; then need_root paccache -rk1 >/dev/null && ok "Old package versions removed (kept the newest)"; fi
  local orph; orph=$(pacman -Qtdq 2>/dev/null)
  if [ -n "$orph" ]; then
    echo "  These are not needed by anything any more:"; echo "$orph" | sed 's/^/    /' | head -n 20
    read -r -p "  Remove them? [y/N] " a
    case "$a" in y|Y) # shellcheck disable=SC2086
      need_root pacman -Rns --noconfirm $orph && ok "Removed" ;; esac
  fi
  have flatpak && flatpak uninstall --unused -y >/dev/null 2>&1 && ok "Unused Flatpak parts removed"
  need_root journalctl --vacuum-size=100M >/dev/null 2>&1 && ok "System log trimmed to 100 MB"
  rm -rf "$HOME/.cache/thumbnails" && ok "Thumbnail cache cleared"
  local after; after=$(df --output=avail -B1M / | tail -n1)
  info "Freed about $(( after - before )) MB"
}

cmd_speed() {
  title "Internet speed"
  have curl || { bad "curl is missing"; return 1; }
  info "Downloading 25 MB from Cloudflare..."
  local bps
  bps=$(curl -o /dev/null -s -w '%{speed_download}' --max-time 30 'https://speed.cloudflare.com/__down?bytes=25000000' 2>/dev/null)
  if [ -n "$bps" ] && [ "${bps%.*}" -gt 0 ] 2>/dev/null; then
    kv "Download" "$(awk -v b="$bps" 'BEGIN{printf "%.1f Mbit/s", b*8/1000000}')"
  else bad "The test did not work (offline?)"; fi
  kv "Ping" "$(ping -c 3 -q 1.1.1.1 2>/dev/null | awk -F/ '/rtt|round-trip/{print $5 " ms"}')"
}

cmd_bench() {
  title "Quick benchmark"
  info "CPU: hashing 1 GB..."
  local s e
  s=$(date +%s%N); head -c 1073741824 /dev/zero | sha256sum >/dev/null; e=$(date +%s%N)
  kv "CPU (1 core)" "$(( (e - s) / 1000000 )) ms  (lower is faster)"
  info "Disk: writing 512 MB..."
  local f; f=$(mktemp -p "${TMPDIR:-$HOME}" rustos-bench.XXXX)
  s=$(date +%s%N); dd if=/dev/zero of="$f" bs=1M count=512 conv=fdatasync status=none 2>/dev/null; e=$(date +%s%N)
  rm -f "$f"
  kv "Disk write" "$(( 512 * 1000 / ( (e - s) / 1000000 + 1 ) )) MB/s"
}

cmd_watch() {
  [ -t 1 ] || { cmd_top; return; }
  local k
  while :; do
    clear
    printf '%s%sRustOS live%s  %s(press q to stop)%s\n' "$B" "$OR" "$R" "$D" "$R"
    kv "CPU load" "$(cut -d' ' -f1-3 /proc/loadavg)  ($(nproc) cores)"
    kv "Memory" "$(free -h | awk '/^Mem:/{print $3 " of " $2}')"
    local t; t=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null); [ -n "$t" ] && kv "Temperature" "$((t / 1000)) °C"
    for b in /sys/class/power_supply/BAT*; do [ -r "$b/capacity" ] && kv "Battery" "$(cat "$b/capacity")% ($(cat "$b/status"))"; done
    echo; ps -eo pcpu,pmem,comm --sort=-pcpu | head -n 11 | sed 's/^/  /'
    read -r -t 2 -n 1 k && [ "$k" = q ] && { echo; return 0; }
  done
}

cmd_crash() {
  title "Programs that crashed"
  if have coredumpctl; then coredumpctl list --no-pager -r 2>/dev/null | head -n 12 | sed 's/^/  /' || ok "No crashes saved"
  else info "coredumpctl is not available"; fi
}

cmd_env() {
  title "Session"
  kv "User" "$USER (groups: $(id -nG | tr ' ' ','))"
  kv "Shell" "$SHELL"
  kv "Session" "${XDG_SESSION_TYPE:-?} / ${XDG_CURRENT_DESKTOP:-?}"
  kv "Language" "${LANG:-?}"
  kv "Keyboard" "$(localectl status 2>/dev/null | awk -F': ' '/X11 Layout/{print $2}')"
  kv "Time zone" "$(timedatectl show -p Timezone --value 2>/dev/null)"
  kv "Clock synced" "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)"
}

cmd_display() {
  title "Screens"
  if have kscreen-doctor; then kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -E 'Output|enabled|Modes|Geometry|Scale' | head -n 20 | sed 's/^/  /'
  else xrandr --current 2>/dev/null | grep -E ' connected|\*' | sed 's/^/  /'; fi
}

cmd_sound() {
  title "Sound"
  if have pactl; then
    kv "Server" "$(pactl info 2>/dev/null | awk -F': ' '/Server Name/{print $2}')"
    kv "Output" "$(pactl get-default-sink 2>/dev/null)"
    kv "Volume" "$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -oE '[0-9]+%' | head -n1)  muted: $(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')"
    kv "Input" "$(pactl get-default-source 2>/dev/null)"
  else bad "pactl is missing"; fi
  info "No sound? Try: $ME fix audio"
}

cmd_bluetooth() {
  title "Bluetooth"
  if ! have bluetoothctl; then bad "Bluetooth tools are not installed"; return; fi
  kv "Service" "$(systemctl is-active bluetooth 2>/dev/null)"
  bluetoothctl show 2>/dev/null | grep -E 'Powered|Discoverable|Name' | sed 's/^\s*/  /'
  echo "  Paired:"; bluetoothctl devices Paired 2>/dev/null | sed 's/^Device /    /'
}

# ------------------------------------------------------------------ fixes
cmd_fix() {
  case "${1:-}" in
    "")
      title "Quick fixes"
      cat <<EOF
  $ME fix plasma        the panel or desktop froze or vanished: restart it
  $ME fix audio         no sound: restart the sound system (PipeWire)
  $ME fix network       Wi-Fi or cable stuck: restart NetworkManager
  $ME fix pacman-lock   "unable to lock database": remove a stale lock
  $ME fix keyring       "signature is invalid / unknown trust": refresh the package keys
  $ME fix ipad          stuck in iPad mode: put the normal desktop back
  $ME fix flatpak       Flatpak apps broken: repair and update them
  $ME fix dns           websites do not open but the network is up
  $ME fix time          the clock is wrong
  $ME fix fonts         letters look wrong or are missing: rebuild the font list
  $ME fix icons         icons missing or wrong in the menu: rebuild the menu cache
  $ME fix initramfs     rebuild the start-up files (after a driver problem)
  $ME fix grub          rebuild the GRUB boot menu (Windows missing from it?)
  $ME fix bootsplash    the boot screen causes trouble: turn it off
  $ME fix mirrors       downloads are slow: pick the fastest package servers
  $ME fix exe           the EXE Center window does not open: reinstall what it needs
EOF
      ;;
    plasma)
      systemctl --user restart plasma-plasmashell.service 2>/dev/null || { kquitapp6 plasmashell 2>/dev/null; sleep 1; setsid -f plasmashell >/dev/null 2>&1; }
      ok "Desktop restarted" ;;
    audio)
      if systemctl --user restart pipewire pipewire-pulse wireplumber 2>/dev/null; then ok "Sound system restarted"; else bad "Could not restart PipeWire"; fi ;;
    network)
      need_root systemctl restart NetworkManager && ok "NetworkManager restarted" ;;
    pacman-lock)
      if pgrep -x pacman >/dev/null; then bad "pacman is still running. Wait for it to finish."; return 1; fi
      if [ -e /var/lib/pacman/db.lck ]; then need_root rm -f /var/lib/pacman/db.lck && ok "Stale lock removed"; else ok "There is no lock"; fi ;;
    keyring)
      need_root pacman -Sy --noconfirm archlinux-keyring 2>/dev/null || need_root pacman -Sy --noconfirm archlinuxarm-keyring
      if [ -r /usr/share/rustos/repo.conf ] && [ -r /usr/share/rustos/rustos-pub.gpg ]; then
        # shellcheck disable=SC1091
        . /usr/share/rustos/repo.conf
        need_root pacman-key --add /usr/share/rustos/rustos-pub.gpg && need_root pacman-key --lsign-key "$REPO_FPR"
      fi
      ok "Keys refreshed. Try the update again." ;;
    ipad)
      have rustos-ipad-mode && rustos-ipad-mode off --quiet && ok "Normal desktop is back" ;;
    flatpak)
      have flatpak || { bad "Flatpak is not installed"; return 1; }
      flatpak repair --user 2>/dev/null; need_root flatpak repair; flatpak update -y && ok "Flatpak repaired" ;;
    dns)
      need_root systemctl restart NetworkManager; resolvectl flush-caches 2>/dev/null
      if getent hosts archlinux.org >/dev/null; then ok "Names work again"; else bad "Still no DNS. Try another network, or set DNS 1.1.1.1 in the network settings."; fi ;;
    time)
      need_root timedatectl set-ntp true && ok "Clock sync is on" && sleep 2 && kv "Synced" "$(timedatectl show -p NTPSynchronized --value)" ;;
    fonts)
      fc-cache -f >/dev/null 2>&1 && ok "Font list rebuilt. Restart your apps." ;;
    icons)
      rm -f "$HOME"/.cache/icon-cache.kcache "$HOME"/.cache/ksycoca6_* 2>/dev/null
      kbuildsycoca6 --noincremental >/dev/null 2>&1; ok "Menu and icon cache rebuilt" ;;
    initramfs)
      need_root mkinitcpio -P && ok "Start-up files rebuilt" ;;
    grub)
      [ -f /etc/default/grub ] || { bad "This PC does not use GRUB"; return 1; }
      need_root grub-mkconfig -o /boot/grub/grub.cfg && ok "GRUB menu rebuilt (it looks for Windows too)" ;;
    bootsplash)
      have rustos-bootsplash && need_root rustos-bootsplash off ;;
    mirrors)
      [ "$(uname -m)" = x86_64 ] || { bad "Only for PCs (ARM uses its own servers)"; return 1; }
      need_root reflector --save /etc/pacman.d/mirrorlist --protocol https --latest 20 --sort rate && ok "Fastest servers picked" ;;
    exe)
      need_root pacman -S --needed --noconfirm python-pyqt6 icoutils && ok "Done. Open RustOS EXE Center again." ;;
    *) bad "Unknown fix: $1"; cmd_fix; return 1 ;;
  esac
}

# ------------------------------------------------------------------ mods
# Built-in mods. Each has: desc, on, off, state (prints on/off).
BUILTIN="dark noanim accent prompt nobanner ipad autoupdate devtools bootsplash"

block_add() {   # block_add NAME "lines" [top]
  block_del "$1"
  touch "$BASHRC"
  local blk; blk="# >>> rustos-mod:$1 >>>"$'\n'"$2"$'\n'"# <<< rustos-mod:$1 <<<"
  if [ "${3:-}" = top ]; then
    printf '%s\n%s\n' "$blk" "$(cat "$BASHRC")" > "$BASHRC.tmp" && mv "$BASHRC.tmp" "$BASHRC"
  else
    printf '%s\n' "$blk" >> "$BASHRC"
  fi
}
block_del() { [ -f "$BASHRC" ] && sed -i "/^# >>> rustos-mod:$1 >>>\$/,/^# <<< rustos-mod:$1 <<<\$/d" "$BASHRC"; }
block_has() { grep -q "^# >>> rustos-mod:$1 >>>\$" "$BASHRC" 2>/dev/null; }
mark() { mkdir -p "${STATE%/*}"; touch "$STATE"; sed -i "/^$1=/d" "$STATE"; [ -n "${2:-}" ] && echo "$1=$2" >> "$STATE"; }
marked() { grep -q "^$1=on\$" "$STATE" 2>/dev/null; }

mod_desc() {
  case "$1" in
    dark)       echo "Dark theme (Breeze Dark) for the whole desktop" ;;
    noanim)     echo "No animations: windows open instantly (faster on old PCs and iPad)" ;;
    accent)     echo "Rust-orange accent color (or your own: .debug mod accent on 120,80,255)" ;;
    prompt)     echo "Colorful RustOS terminal prompt" ;;
    nobanner)   echo "No fastfetch banner when a terminal opens" ;;
    ipad)       echo "iPad mode: dock, app grid, touch keyboard" ;;
    autoupdate) echo "Automatic updates every day" ;;
    devtools)   echo "Programming tools: gcc, make, git, base-devel (installs them)" ;;
    bootsplash) echo "RustOS boot screen (logo and progress bar while the PC starts)" ;;
  esac
}
mod_state() {
  case "$1" in
    dark)       [ "$(kr --file kdeglobals --group General --key ColorScheme)" = BreezeDark ] && echo on || echo off ;;
    noanim)     [ "$(kr --file kdeglobals --group KDE --key AnimationDurationFactor)" = 0 ] && echo on || echo off ;;
    accent)     [ -n "$(kr --file kdeglobals --group General --key AccentColor)" ] && echo on || echo off ;;
    prompt)     block_has prompt && echo on || echo off ;;
    nobanner)   block_has nobanner && echo on || echo off ;;
    ipad)       have rustos-ipad-mode && rustos-ipad-mode status 2>/dev/null | grep -q '^on' && echo on || echo off ;;
    autoupdate) systemctl is-enabled --quiet rustos-update.timer 2>/dev/null && echo on || echo off ;;
    devtools)   pacman -Qq base-devel >/dev/null 2>&1 && pacman -Qq git >/dev/null 2>&1 && echo on || echo off ;;
    bootsplash) have rustos-bootsplash && rustos-bootsplash status 2>/dev/null | grep -q ': ON' && echo on || echo off ;;
  esac
}
mod_set() {   # mod_set NAME on|off [arg]
  local n=$1 v=$2 a=${3:-}
  case "$n:$v" in
    dark:on)        plasma-apply-colorscheme BreezeDark >/dev/null 2>&1 || kw --file kdeglobals --group General --key ColorScheme BreezeDark ;;
    dark:off)       plasma-apply-colorscheme BreezeLight >/dev/null 2>&1 || kw --file kdeglobals --group General --key ColorScheme BreezeLight ;;
    noanim:on)      kw --file kdeglobals --group KDE --key AnimationDurationFactor 0; kde_notify 1 ;;
    noanim:off)     kw --file kdeglobals --group KDE --key AnimationDurationFactor --delete; kde_notify 1 ;;
    accent:on)
      a=${a:-255,154,60}
      printf '%s' "$a" | grep -Eq '^[0-9]{1,3},[0-9]{1,3},[0-9]{1,3}$' || { bad "Color must look like 255,154,60"; return 1; }
      kw --file kdeglobals --group General --key AccentColor "$a"; kde_notify 0 ;;
    accent:off)     kw --file kdeglobals --group General --key AccentColor --delete; kde_notify 0 ;;
    prompt:on)      block_add prompt "PS1='\\[\\e[38;5;208m\\]\\u@\\h\\[\\e[0m\\] \\[\\e[38;5;37m\\]\\w\\[\\e[0m\\] \\[\\e[38;5;208m\\]>\\[\\e[0m\\] '" ;;
    prompt:off)     block_del prompt ;;
    nobanner:on)    block_add nobanner "export RUSTOS_BANNER_DONE=1" top ;;
    nobanner:off)   block_del nobanner ;;
    ipad:on)        rustos-ipad-mode on ;;
    ipad:off)       rustos-ipad-mode off ;;
    autoupdate:on)  rustos-autoupdate on ;;
    autoupdate:off) rustos-autoupdate off ;;
    devtools:on)    need_root pacman -S --needed --noconfirm base-devel git ;;
    bootsplash:on)  need_root rustos-bootsplash on ;;
    bootsplash:off) need_root rustos-bootsplash off ;;
    devtools:off)   info "The tools stay installed (other apps may need them). Remove them by hand: sudo pacman -Rns base-devel"; return 0 ;;
    *) return 2 ;;
  esac
}

# your own mods: ~/.config/rustos/mods/NAME.sh with desc=..., on(), off(), and optionally state()
user_mods() { [ -d "$MODDIR" ] && find "$MODDIR" -maxdepth 1 -name '*.sh' -printf '%f\n' 2>/dev/null | sed 's/\.sh$//' | sort; }
is_user_mod() { [ -f "$MODDIR/$1.sh" ]; }
umod() {   # umod NAME desc|on|off|state
  bash -c '
    set +e
    desc=""
    . "$1" || exit 3
    case "$2" in
      desc)  echo "${desc:-your own mod}" ;;
      state) if declare -F state >/dev/null; then state; else grep -q "^$3=on\$" "$4" 2>/dev/null && echo on || echo off; fi ;;
      on|off) declare -F "$2" >/dev/null || { echo "This mod has no $2() part."; exit 4; }; "$2" ;;
    esac' _ "$MODDIR/$1.sh" "$2" "$1" "$STATE"
}

all_mods() { for m in $BUILTIN; do echo "$m"; done; user_mods; }
any_desc()  { if is_user_mod "$1"; then umod "$1" desc; else mod_desc "$1"; fi; }
any_state() { if is_user_mod "$1"; then umod "$1" state; else mod_state "$1"; fi; }
known() { case " $BUILTIN " in *" $1 "*) return 0 ;; esac; is_user_mod "$1"; }

any_set() {   # any_set NAME on|off [arg]
  local rc
  if is_user_mod "$1"; then umod "$1" "$2"; rc=$?; [ $rc = 0 ] && mark "$1" "$2"
  else mod_set "$@"; rc=$?; fi
  if [ $rc = 0 ]; then
    if [ "$2" = on ]; then ok "$1 is on"; else ok "$1 is off"; fi
    case "$1" in prompt|nobanner) info "Open a new terminal (or run: source ~/.bashrc) to see it." ;; dark|accent) info "Some apps change after you reopen them." ;; esac
  else bad "Could not turn $1 $2"; fi
  return $rc
}

cmd_mods() {
  title "Mods"
  local m s
  while read -r m; do
    [ -n "$m" ] || continue
    s=$(any_state "$m")
    if [ "$s" = on ]; then printf '  %s[ON ]%s %s%-11s%s %s\n' "$GR" "$R" "$B" "$m" "$R" "$(any_desc "$m")"
    else printf '  %s[off]%s %-11s %s\n' "$D" "$R" "$m" "$(any_desc "$m")"; fi
  done < <(all_mods)
  echo; info "Turn one on or off: $ME mod <name> on|off   or use the menu: $ME mainmod"
}

mod_new() {
  local n=$1 f
  printf '%s' "$n" | grep -Eq '^[a-z][a-z0-9_-]{0,30}$' || { bad "Use a short name: small letters, numbers, - or _"; return 1; }
  case " $BUILTIN " in *" $n "*) bad "$n is a built-in mod. Pick another name."; return 1 ;; esac
  mkdir -p "$MODDIR"; f="$MODDIR/$n.sh"
  [ -e "$f" ] && { bad "$f already exists. Edit it with: $ME mod edit $n"; return 1; }
  cat > "$f" <<EOF
# RustOS mod: $n
# Turn it on with:  .debug mod $n on      and off with:  .debug mod $n off
# Put any commands you like into on() and off(). They run as you (use sudo for system changes).
desc="My mod: $n"

on() {
  echo "Turning $n on"
  # examples:
  #   kwriteconfig6 --file kdeglobals --group General --key AccentColor 0,170,255
  #   echo "alias hi='echo hello'" >> ~/.bashrc
  #   notify-send "RustOS" "$n is on"
}

off() {
  echo "Turning $n off"
}

# Optional: print "on" or "off" so .debug mods can show the real state.
# state() { echo off; }
EOF
  ok "Made $f"
  info "Edit it with: $ME mod edit $n   then turn it on with: $ME mod $n on"
}

cmd_mod() {
  local n=${1:-} v=${2:-}
  case "$n" in
    ""|list) cmd_mods; return ;;
    new)    [ -n "$v" ] || { echo "Use: $ME mod new <name>"; return 1; }; mod_new "$v"; return ;;
    edit)   is_user_mod "$v" || { bad "No own mod called '$v'. Make one: $ME mod new $v"; return 1; }
            "${EDITOR:-$(command -v kate || command -v nano || echo vi)}" "$MODDIR/$v.sh"; return ;;
    delete) is_user_mod "$v" || { bad "No own mod called '$v'"; return 1; }; rm -f "$MODDIR/$v.sh"; mark "$v"; ok "Deleted $v"; return ;;
  esac
  known "$n" || { bad "There is no mod called '$n'"; cmd_mods; return 1; }
  case "$v" in
    on|off) any_set "$n" "$v" "${3:-}" ;;
    toggle) if [ "$(any_state "$n")" = on ]; then any_set "$n" off; else any_set "$n" on; fi ;;
    ""|status) echo "$n: $(any_state "$n")  -  $(any_desc "$n")" ;;
    *) echo "Use: $ME mod $n on|off|toggle|status"; return 1 ;;
  esac
}

cmd_mainmod() {
  local mods=() i c n
  while :; do
    mapfile -t mods < <(all_mods)
    printf '\n%s%s  RustOS main mod menu  %s\n' "$B" "$OR" "$R"
    printf '  %sPick a number to turn a mod on or off.%s\n\n' "$D" "$R"
    for i in "${!mods[@]}"; do
      if [ "$(any_state "${mods[i]}")" = on ]; then c="${GR}[ON ]${R}"; else c="${D}[off]${R}"; fi
      printf '  %s%2d%s  %s  %-11s %s\n' "$OR" "$((i + 1))" "$R" "$c" "${mods[i]}" "$(any_desc "${mods[i]}")"
    done
    printf '\n  %s n%s  make your own mod    %s i%s  info    %s f%s  quick fixes    %s q%s  quit\n' "$OR" "$R" "$OR" "$R" "$OR" "$R" "$OR" "$R"
    read -r -p "  > " c || { echo; return 0; }
    case "$c" in
      q|Q|"") return 0 ;;
      n|N) read -r -p "  Name for your mod: " n || return 0; mod_new "$n" ;;
      i|I) cmd_info ;;
      f|F) cmd_fix; read -r -p "  Fix name (or Enter to go back): " n || return 0; [ -n "$n" ] && cmd_fix "$n" ;;
      *[!0-9]*) bad "Type a number from the list" ;;
      *) if [ "$c" -ge 1 ] && [ "$c" -le "${#mods[@]}" ]; then cmd_mod "${mods[c - 1]}" toggle; else bad "Type a number from the list"; fi ;;
    esac
  done
}

# ------------------------------------------------------------------ main
sub=${1:-}; shift 2>/dev/null || true
case "$sub" in
  "")                 overview ;;
  help|-h|--help)     usage ;;
  version|-v)         echo "RustOS $(rustos_version)" ;;
  info)               cmd_info ;;
  update|updates)     cmd_update ;;
  logs|log)           cmd_logs "$@" ;;
  services|svc)       cmd_services ;;
  net|network)        cmd_net ;;
  gpu)                cmd_gpu ;;
  disk)               cmd_disk ;;
  report)             cmd_report ;;
  fix)                cmd_fix "$@" ;;
  mods)               cmd_mods ;;
  mod)                cmd_mod "$@" ;;
  mainmod|menu)       cmd_mainmod ;;
  boot)               cmd_boot ;;
  temp|temps)         cmd_temp ;;
  battery|bat)        cmd_battery ;;
  top)                cmd_top ;;
  usb)                cmd_usb ;;
  ports)              cmd_ports ;;
  wine|exe)           cmd_wine ;;
  packages|pkgs)      cmd_packages ;;
  history)            cmd_history "$@" ;;
  restore)            cmd_restore ;;
  clean)              cmd_clean ;;
  speed)              cmd_speed ;;
  bench)              cmd_bench ;;
  watch|live)         cmd_watch ;;
  crash|crashes)      cmd_crash ;;
  env)                cmd_env ;;
  display|screens)    cmd_display ;;
  sound|audio)        cmd_sound ;;
  bluetooth|bt)       cmd_bluetooth ;;
  _names)             all_mods ;;          # for tab completion
  *) bad "Unknown command: $sub"; echo "  Type:  $ME help"; exit 1 ;;
esac
