#!/usr/bin/env bash
# Runs a Windows program (.exe, .msi, .bat, .lnk) with Wine. Double-click a .exe and this opens it.
#   rustos-run-exe file.exe          run it
#   rustos-run-exe --game file.exe   run it with GameMode and the MangoHud overlay
#   rustos-run-exe --ensure          only make sure Windows support (Wine) is installed and ready
#   rustos-run-exe                   pick a file first
# If Wine is not installed yet, it offers to install it (once).
T="RustOS EXE Center"

game=0; ensure_only=0
case "${1:-}" in
  --game)   game=1; shift ;;
  --ensure) ensure_only=1; shift ;;
esac
f="${1:-}"
[ "$#" -gt 0 ] && shift
EXTRA=("$@")          # extra arguments for the program (from the EXE Center settings)

if [ "$(uname -m)" != x86_64 ]; then
  kdialog --title "$T" --icon rustos --msgbox "Windows .exe programs need an Intel or AMD (x86) PC.<br>This is the ARM edition of RustOS, so they cannot run here.<br><br>Look for a Linux version of the program, or use its website."
  exit 1
fi

ensure_wine() {
  command -v wine >/dev/null 2>&1 && return 0
  if [ -d /run/archiso ]; then
    kdialog --title "$T" --icon rustos --msgbox "Windows programs can be run after RustOS is installed on this PC."
    return 1
  fi
  kdialog --title "$T" --icon rustos --yes-label "Install support" --no-label "Cancel" --yesno \
"<b>This needs Windows support.</b><br><br>
RustOS runs many Windows programs and games with <b>Wine</b>. It is not installed yet.<br><br>
Install it now? It downloads a few hundred MB and asks for your password. After that, every .exe opens with a double-click.<br><br>
Not every program works. Games with anti-cheat, Microsoft Office and Adobe programs usually do not." || return 1
  rm -f /run/rustos-gaming.status
  konsole --nofork --title "RustOS EXE Center" -e bash -c \
    'sudo /usr/local/bin/rustos-gaming --install wine; echo; read -r -p "Press Enter to close this window. " _'
  if [ "$(cat /run/rustos-gaming.status 2>/dev/null)" != ok ] || ! command -v wine >/dev/null 2>&1; then
    kdialog --title "$T" --icon rustos --sorry "Windows support was not installed.<br>Scroll the terminal window for the first error, or try again."
    return 1
  fi
  return 0
}

prepare_prefix() {
  [ -d "$HOME/.wine" ] && return 0
  kdialog --title "$T" --passivepopup "Setting up the Windows environment. This only happens the first time and can take a minute." 8 2>/dev/null
  WINEDEBUG=-all wineboot -u >/dev/null 2>&1
  return 0
}

if [ "$ensure_only" = 1 ]; then
  ensure_wine && prepare_prefix
  exit 0
fi

if [ -z "$f" ]; then
  f=$(kdialog --title "$T" --icon rustos --getopenfilename "$HOME" "*.exe *.EXE *.msi *.MSI *.bat *.BAT *.lnk *.LNK|Windows programs") || exit 0
fi
[ -e "$f" ] || { kdialog --title "$T" --icon rustos --error "That file was not found:<br>$f"; exit 1; }

# a .dll cannot be "run": offer to install it instead
case "${f,,}" in
  *.dll|*.ocx) exec /usr/local/bin/rustos-exe-center --dll "$f" ;;
esac

# warn about things that are known not to work well (the person can still run it)
known_problem() {
  local base dir
  base=$(basename -- "$f"); base=${base,,}; dir=$(dirname -- "$f")
  case "$base" in
    *officesetup*|*office365*|*microsoft365*|*microsoft-365*|*o365*)
      echo "Microsoft Office does not run well under Wine. LibreOffice, or Microsoft 365 in the browser, works better."; return 0 ;;
    *photoshop*|*creativecloud*|*illustrator*|*lightroom*|*premiere*|*aftereffects*|*acrobat*)
      echo "Adobe programs usually do not run under Wine. GIMP, Krita, Inkscape and Kdenlive are the alternatives."; return 0 ;;
  esac
  # look for anti-cheat in the game's folder or one or two folders above it (not in big shared folders)
  local d="$dir"
  for _ in 1 2 3; do
    case "$d" in "$HOME"|"$HOME"/Downloads|"$HOME"/Desktop|"$HOME"/Documents|/|/tmp|.) break ;; esac
    if find "$d" -maxdepth 2 \( -iname 'EasyAntiCheat*' -o -iname 'BEService*' -o -iname 'BattlEye*' -o -iname 'vgc.exe' \
         -o -iname 'EAAntiCheat*' -o -iname 'xigncode*' -o -iname 'FACEIT*' \) -print -quit 2>/dev/null | grep -q .; then
      echo "This game has anti-cheat software. Online play often does not work on Linux unless the game's makers allow it."
      return 0
    fi
    d=$(dirname -- "$d")
  done
  return 1
}

if [ "${RUSTOS_NOWARN:-0}" != 1 ] && hint=$(known_problem); then
  kdialog --title "$T" --icon rustos --warningcontinuecancel \
    "<b>This one may not work.</b><br><br>$hint<br><br>You can still try it. Nothing is harmed if it fails." || exit 0
fi

ensure_wine || exit 1
prepare_prefix

cd "$(dirname "$f")" || true
export WINEDEBUG="${RUSTOS_WINEDEBUG:--all}"   # the EXE Center sets this to show Wine errors in its log
launch=(wine)
if [ "$game" = 1 ]; then
  command -v gamemoderun >/dev/null 2>&1 && launch=(gamemoderun "${launch[@]}")
  command -v mangohud >/dev/null 2>&1 && launch=(mangohud "${launch[@]}")
fi

case "${f,,}" in
  *.msi)        exec "${launch[@]}" msiexec /i "$f" "${EXTRA[@]}" ;;
  *.bat|*.cmd)  exec "${launch[@]}" cmd /c "$f" ;;
  *.lnk)        exec "${launch[@]}" start /unix "$f" "${EXTRA[@]}" ;;
  *)            exec "${launch[@]}" "$f" "${EXTRA[@]}" ;;
esac
