#!/usr/bin/env bash
# Runs at Plasma login until done: sets the RustOS wallpaper once, then asks ONCE if you want to set up apps and gaming.
sleep 5
MARK="$HOME/.config/rustos-branding-done"
if [ ! -e "$MARK" ]; then
  if plasma-apply-wallpaperimage /usr/share/rustos/wallpaper.png; then
    mkdir -p "$HOME/.config" && touch "$MARK"
  fi
fi

# the live disk is only for trying and installing
[ -d /run/archiso ] && exit 0
GMARK="$HOME/.config/rustos-setup-asked"
[ -e "$GMARK" ] && exit 0
[ -x /usr/local/bin/rustos-apps ] || exit 0
sleep 25
mkdir -p "$HOME/.config" && touch "$GMARK"
kdialog --title "RustOS" --icon rustos --yes-label "Choose apps" --no-label "Not now" --yesno \
  "<b>Welcome to RustOS!</b><br><br>Want to set up your PC now?<br><br>\
You can add an office suite, a video player, printing, <b>Windows .exe support</b> and <b>gaming</b> (Steam and the right graphics driver) in a few clicks.<br><br>\
Later: open the menu and search for <b>RustOS Apps</b>, <b>RustOS Gaming Setup</b> or <b>Switching from Windows</b>." \
  && /usr/local/bin/rustos-apps
exit 0
