#!/usr/bin/env bash
# RustOS automatic updater. Runs from rustos-update.timer, or by hand:  sudo rustos-update --now
# Updates all packages (pacman) and Flatpak apps, then tells the desktop if a restart is needed.
set -u
[ -d /run/archiso ] && exit 0                         # never on the live USB
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"

LOG=/var/log/rustos-update.log
exec 9>/run/rustos-update.lock
flock -n 9 || { echo "Another update is already running."; exit 0; }
# started from a terminal (Update Center): show it on screen AND keep the log; from the timer: log only
if [ -t 1 ]; then exec > >(tee -a "$LOG") 2>&1; else exec >>"$LOG" 2>&1; fi
echo "=== $(date '+%F %T') ==="

notify() {   # show a desktop notification to everyone logged in graphically
  local sid user uid type
  while read -r sid _; do
    type=$(loginctl show-session "$sid" -p Type --value 2>/dev/null)
    case "$type" in x11|wayland) ;; *) continue ;; esac
    user=$(loginctl show-session "$sid" -p Name --value 2>/dev/null)
    uid=$(id -u "$user" 2>/dev/null) || continue
    runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
      notify-send -i rustos "RustOS" "$1" 2>/dev/null || true
  done < <(loginctl list-sessions --no-legend 2>/dev/null)
}

on_ac() {    # true on desktops/VMs (no battery) and laptops that are plugged in
  local any=0 ac=0 f
  for f in /sys/class/power_supply/*/type; do
    [ -r "$f" ] || continue
    if [ "$(cat "$f")" = Mains ]; then
      any=1
      [ "$(cat "${f%type}online" 2>/dev/null)" = 1 ] && ac=1
    fi
  done
  [ "$any" = 0 ] || [ "$ac" = 1 ]
}

HOLD=/var/lib/rustos/update-hold
if [ "${1:-}" != "--now" ]; then
  if [ -r "$HOLD" ] && [ "$(date +%s)" -lt "$(cat "$HOLD")" ]; then
    echo "Updates are paused (after an undo) - skipping."
    exit 0
  fi
else
  rm -f "$HOLD"
fi
if [ "${1:-}" != "--now" ]; then
  on_ac || { echo "Running on battery - skipping."; exit 0; }
fi
curl -fsI --max-time 15 https://geo.mirror.pkgbuild.com >/dev/null 2>&1 || { echo "No internet - skipping."; exit 0; }
[ -e /var/lib/pacman/db.lck ] && { echo "pacman is busy (db.lck) - skipping."; exit 0; }

echo "Updating packages..."
pacman -Sy --noconfirm --needed archlinux-keyring || true       # keep the signing keys fresh first
if ! timeout 3h pacman -Su --noconfirm --noprogressbar; then
  echo "pacman update FAILED."
  notify "The automatic update failed. Open a terminal and run: sudo rustos-update --now"
  exit 1
fi
if command -v flatpak >/dev/null 2>&1; then
  echo "Updating Flatpak apps..."
  flatpak update -y --noninteractive || true
fi

# the "RustOS updated" popup (what is new, restart button) comes from the pacman hook rustos-update-event
if [ ! -d "/usr/lib/modules/$(uname -r)" ]; then
  echo "Kernel was updated - restart needed."
else
  echo "Update finished."
fi
